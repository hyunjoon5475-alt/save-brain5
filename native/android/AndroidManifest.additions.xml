<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Usage access is a special app access. The user must enable it in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Limit package visibility to launchable apps rather than requesting QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="com.savebrain.app.FocusShieldActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <service
            android:name="com.savebrain.app.FocusAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="OFFROOM 집중 모드">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/save_brain_accessibility_service" />
        </service>
    </application>
</manifest>
